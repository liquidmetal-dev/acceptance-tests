# --- DigitalOcean ---
DO_API_TOKEN=              # required: DigitalOcean API token
DO_REGION=nyc3            # must offer nested-virt Basic droplets + block storage
DO_DROPLET_SIZE=s-4vcpu-8gb
DO_IMAGE=ubuntu-22-04-x64
DO_BLOCK_VOLUME_GB=50     # raw volume per droplet for the flintlock thinpool

# --- Run identity ---
RUN_ID=                   # optional; auto-generated as at-<8hex> if empty

# --- SSH (runner -> droplet -> microVM) ---
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519

# --- microVM images (REQUIRED - supply known-good OCI refs) ---
MICROVM_KERNEL_IMAGE=     # e.g. ghcr.io/liquidmetal-dev/flintlock-kernel:5.10
MICROVM_ROOTFS_IMAGE=     # e.g. ghcr.io/liquidmetal-dev/capmvm-kubernetes:1.28
MICROVM_KERNEL_FILENAME=  # optional; defaults to provider default (e.g. boot/vmlinux)

# --- microVM shape / placement test ---
MICROVM_NAMESPACE=        # defaults to RUN_ID
MICROVM_VCPU=1
MICROVM_MEM_MB=512
MICROVM_COUNT=4
MICROVM_SUBNET_CIDR=192.168.100.0/24   # static IPs assigned .10, .11, ...

# --- brigade ---
BRIGADE_GRPC_PORT=9091
BRIGADE_STATUS_PORT=9600
BRIGADE_COOKIE=           # defaults to RUN_ID
BRIGADE_MIN_CLUSTER_SIZE=2
BRIGADE_REF=main
FLINTLOCK_REF=main
FLINTLOCK_GRPC_PORT=9090

# --- timeouts (seconds) ---
TIMEOUT_PROVISION=300
TIMEOUT_BOOTSTRAP=1200
TIMEOUT_CLUSTER=180
TIMEOUT_VM_CREATE=300
TIMEOUT_VM_DELETE=120
TIMEOUT_SSH=180

# --- debugging ---
KEEP_INFRA_ON_FAILURE=false
ARTIFACTS_DIR=./artifacts
