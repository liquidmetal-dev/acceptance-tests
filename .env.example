# --- DigitalOcean ---
# required: DigitalOcean API token
DO_API_TOKEN=
DO_REGION=nyc3            # must offer nested-virt Basic droplets + block storage
DO_DROPLET_SIZE=s-4vcpu-8gb
DO_IMAGE=ubuntu-22-04-x64
DO_BLOCK_VOLUME_GB=50     # raw volume per droplet for the flintlock thinpool

# --- Run identity ---
# optional; auto-generated as at-<8hex> if empty
RUN_ID=

# --- SSH (runner -> droplet -> microVM) ---
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519

# --- microVM images (REQUIRED - supply known-good OCI refs) ---
# e.g. ghcr.io/liquidmetal-dev/flintlock-kernel:5.10
MICROVM_KERNEL_IMAGE=
# e.g. ghcr.io/liquidmetal-dev/capmvm-kubernetes:1.28
MICROVM_ROOTFS_IMAGE=
# kernel path inside the OCI image; flintlock requires it. defaults to boot/vmlinux
# (correct for the standard liquidmetal *-kernel images).
MICROVM_KERNEL_FILENAME=boot/vmlinux

# --- hypervisor provider ---
# firecracker (default) | cloudhypervisor. Selects the flintlock VM provider for the
# whole run; both binaries are installed on every host so either works per run.
MICROVM_PROVIDER=firecracker
# Cloud Hypervisor needs a PVH-capable kernel. If set, these override the images above when
# MICROVM_PROVIDER=cloudhypervisor; otherwise the firecracker kernel is reused. Note the CH
# kernel image ships its kernel at a different path than the firecracker one — the
# liquidmetal cloudhypervisor-kernel-k8s image has vmlinux.bin at the root (not boot/vmlinux),
# so set MICROVM_CH_KERNEL_FILENAME to match or the guest never boots.
# e.g. MICROVM_CH_KERNEL_IMAGE=ghcr.io/liquidmetal-dev/cloudhypervisor-kernel-k8s:6.2
#      MICROVM_CH_KERNEL_FILENAME=vmlinux.bin
MICROVM_CH_KERNEL_IMAGE=
MICROVM_CH_KERNEL_FILENAME=

# --- microVM shape / placement test ---
# defaults to RUN_ID
MICROVM_NAMESPACE=
MICROVM_VCPU=1
# flintlock requires 1024-32768
MICROVM_MEM_MB=1024
MICROVM_COUNT=4
MICROVM_SUBNET_CIDR=192.168.100.0/24   # static IPs assigned .10, .11, ...

# --- cluster ---
NODE_COUNT=2                 # brigade nodes / flintlock host droplets

# --- brigade ---
BRIGADE_GRPC_PORT=9091
BRIGADE_STATUS_PORT=9600
# defaults to RUN_ID
BRIGADE_COOKIE=
# defaults to NODE_COUNT when unset
BRIGADE_MIN_CLUSTER_SIZE=2
BRIGADE_REF=main
FLINTLOCK_REF=main
FLINTLOCK_GRPC_PORT=9090

# --- timeouts (seconds) ---
TIMEOUT_PROVISION=300
TIMEOUT_BOOTSTRAP=1200
TIMEOUT_CLUSTER=180
TIMEOUT_VM_CREATE=300
TIMEOUT_VM_DELETE=120
TIMEOUT_SSH=180

# --- debugging ---
KEEP_INFRA_ON_FAILURE=false
ARTIFACTS_DIR=./artifacts
# Emit DigitalOcean API HTTP request/response logs (noisy). Also: pytest --log-http
LOG_HTTP=false
