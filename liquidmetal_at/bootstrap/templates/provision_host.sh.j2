#!/usr/bin/env bash
# Provision one flintlock host. Run as root over SSH so we get exit codes + logs.
# Idempotent-ish: safe to re-run; provision.sh skips already-installed components.
set -euo pipefail

# apt runs non-interactively over SSH (no tty); silence debconf/dpkg-preconfigure.
export DEBIAN_FRONTEND=noninteractive

FLINTLOCK_DIR=/opt/flintlock
THINPOOL={{ thinpool }}
DISK={{ disk }}
PARENT_IFACE={{ parent_iface }}
GRPC_PORT={{ flintlock_grpc_port }}

echo "== waiting for base cloud-init marker =="
for i in $(seq 1 120); do
  [ -f /var/lib/lm-acceptance/base-ready ] && break
  sleep 5
done
test -f /var/lib/lm-acceptance/base-ready || { echo "base-ready marker missing"; exit 1; }

test -e /dev/kvm || { echo "FATAL: /dev/kvm not present - nested virt unavailable"; exit 1; }

echo "== provisioning flintlock stack (containerd, firecracker, cloudhypervisor, thinpool) =="
cd "$FLINTLOCK_DIR"
{% if flintlock_version|default('') %}
# Pin the flintlockd release provision.sh installs (it reads ${FLINTLOCK:-latest}). Keeps the
# version under test deterministic instead of tracking whatever the latest GitHub release is.
export FLINTLOCK={{ flintlock_version }}
echo "== pinning flintlockd release to $FLINTLOCK =="
{% endif %}
# provision.sh sets up containerd + firecracker + a devicemapper thinpool.
# --dev builds a loop-device thinpool named by --thinpool; under --dev the
# --disk flag is ignored, so we omit it (raw block volume is not used here).
if [ -x ./hack/scripts/provision.sh ]; then
  ./hack/scripts/provision.sh all \
    --dev \
    --unattended \
    --insecure \
    --thinpool "$THINPOOL" || {
      echo "provision.sh 'all' failed; retrying component subcommands"
      ./hack/scripts/provision.sh devpool --thinpool "$THINPOOL" --unattended || true
      ./hack/scripts/provision.sh containerd --thinpool "$THINPOOL" --unattended || true
      ./hack/scripts/provision.sh firecracker || true
    }
  # provision.sh 'all' already runs the cloudhypervisor step, but re-run it explicitly so
  # both providers are installed even on flintlock versions whose 'all' omits it. Cheap and
  # idempotent (re-downloads the release binary).
  ./hack/scripts/provision.sh cloudhypervisor || true
else
  echo "FATAL: provision.sh not found in $FLINTLOCK_DIR/hack/scripts"; exit 1
fi

# provision.sh installs the Cloud Hypervisor release asset under its upstream name
# 'cloud-hypervisor-static' (the static musl build). flintlockd's --cloudhypervisor-bin below
# points at the canonical '/usr/local/bin/cloud-hypervisor', so expose a stable name via
# symlink regardless of which asset name was installed. Fail fast if the binary is genuinely
# absent — otherwise flintlockd registers the provider but every VM create dies at exec time
# with "starting cloud hypervisor process: %!w(<nil>)".
if [ ! -x /usr/local/bin/cloud-hypervisor ]; then
  for cand in cloud-hypervisor-static cloud-hypervisor; do
    if [ -x "/usr/local/bin/$cand" ]; then
      ln -sf "/usr/local/bin/$cand" /usr/local/bin/cloud-hypervisor
      break
    fi
  done
fi
command -v cloud-hypervisor >/dev/null \
  || { echo "FATAL: cloud-hypervisor not installed (checked cloud-hypervisor-static)"; exit 1; }

echo "== installing flintlockd binary =="
if [ ! -x /usr/local/bin/flintlockd ]; then
  # provision.sh 'all' usually installs it; fall back to building from source.
  if [ -f "$FLINTLOCK_DIR/bin/flintlockd" ]; then
    install -m0755 "$FLINTLOCK_DIR/bin/flintlockd" /usr/local/bin/flintlockd
  else
    (cd "$FLINTLOCK_DIR" && make build 2>/dev/null || true)
    [ -f "$FLINTLOCK_DIR/bin/flintlockd" ] && install -m0755 "$FLINTLOCK_DIR/bin/flintlockd" /usr/local/bin/flintlockd
  fi
fi
command -v flintlockd >/dev/null || { echo "FATAL: flintlockd not installed"; exit 1; }

echo "== detecting containerd socket =="
CONTAINERD_SOCK=/run/containerd-dev/containerd.sock
[ -S "$CONTAINERD_SOCK" ] || CONTAINERD_SOCK=/run/containerd/containerd.sock

echo "== setting up flintlock bridge {{ bridge_name }} =="
# flintlock attaches guest TAP devices to this Linux bridge. The guests' static IPs
# live on {{ guest_subnet }} with the bridge as their gateway; masquerade gives outbound.
BRIDGE={{ bridge_name }}
BRIDGE_ADDR={{ bridge_addr }}
GUEST_SUBNET={{ guest_subnet }}
if ! ip link show "$BRIDGE" >/dev/null 2>&1; then
  ip link add name "$BRIDGE" type bridge
fi
ip addr replace "$BRIDGE_ADDR" dev "$BRIDGE"
ip link set "$BRIDGE" up
sysctl -qw net.ipv4.ip_forward=1
UPLINK=$(ip route show default | awk '/default/{print $5; exit}')
if [ -n "$UPLINK" ]; then
  iptables -t nat -C POSTROUTING -s "$GUEST_SUBNET" ! -o "$BRIDGE" -j MASQUERADE 2>/dev/null \
    || iptables -t nat -A POSTROUTING -s "$GUEST_SUBNET" ! -o "$BRIDGE" -j MASQUERADE
fi
iptables -C FORWARD -i "$BRIDGE" -j ACCEPT 2>/dev/null || iptables -A FORWARD -i "$BRIDGE" -j ACCEPT
iptables -C FORWARD -o "$BRIDGE" -j ACCEPT 2>/dev/null || iptables -A FORWARD -o "$BRIDGE" -j ACCEPT

echo "== writing flintlockd systemd unit =="
# provision.sh's 'flintlock' step (via 'all') already installed + started its own
# flintlockd.service bound to the host internal IP. Stop it so our unit — which binds
# 0.0.0.0 for the 127.0.0.1 healthcheck + cross-node brigade — can take over cleanly.
# Stopping before daemon-reload also avoids systemd's "Current command vanished" churn.
systemctl stop flintlockd.service 2>/dev/null || true
cat >/etc/systemd/system/flintlockd.service <<EOF
[Unit]
Description=flintlockd (acceptance)
After=network-online.target containerd.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/flintlockd run \\
  --grpc-endpoint=0.0.0.0:${GRPC_PORT} \\
  --containerd-socket=${CONTAINERD_SOCK} \\
  --parent-iface=${PARENT_IFACE} \\
  --bridge-name=${BRIDGE} \\
  --cloudhypervisor-bin=/usr/local/bin/cloud-hypervisor \\
  --insecure --verbosity 1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable flintlockd.service
systemctl restart flintlockd.service   # force-apply our config even if one was running

echo "== waiting for flintlockd :${GRPC_PORT} =="
for i in $(seq 1 60); do
  if timeout 2 bash -c "</dev/tcp/127.0.0.1/${GRPC_PORT}" 2>/dev/null; then
    echo "flintlockd is listening"; exit 0
  fi
  sleep 2
done
echo "FATAL: flintlockd not listening on ${GRPC_PORT}"; journalctl -u flintlockd --no-pager | tail -50; exit 1
