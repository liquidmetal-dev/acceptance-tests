#!/usr/bin/env bash
# Provision one flintlock host. Run as root over SSH so we get exit codes + logs.
# Idempotent-ish: safe to re-run; provision.sh skips already-installed components.
set -euo pipefail

FLINTLOCK_DIR=/opt/flintlock
THINPOOL={{ thinpool }}
DISK={{ disk }}
PARENT_IFACE={{ parent_iface }}
GRPC_PORT={{ flintlock_grpc_port }}

echo "== waiting for base cloud-init marker =="
for i in $(seq 1 120); do
  [ -f /var/lib/lm-acceptance/base-ready ] && break
  sleep 5
done
test -f /var/lib/lm-acceptance/base-ready || { echo "base-ready marker missing"; exit 1; }

test -e /dev/kvm || { echo "FATAL: /dev/kvm not present - nested virt unavailable"; exit 1; }

echo "== provisioning flintlock stack (containerd, firecracker, thinpool) =="
cd "$FLINTLOCK_DIR"
# provision.sh sets up containerd + firecracker + a devicemapper thinpool.
# --dev builds a loop-device thinpool named by --thinpool; under --dev the
# --disk flag is ignored, so we omit it (raw block volume is not used here).
if [ -x ./hack/scripts/provision.sh ]; then
  ./hack/scripts/provision.sh all \
    --dev \
    --unattended \
    --thinpool "$THINPOOL" || {
      echo "provision.sh 'all' failed; retrying component subcommands"
      ./hack/scripts/provision.sh devpool --thinpool "$THINPOOL" --unattended || true
      ./hack/scripts/provision.sh containerd --thinpool "$THINPOOL" --unattended || true
      ./hack/scripts/provision.sh firecracker || true
    }
else
  echo "FATAL: provision.sh not found in $FLINTLOCK_DIR/hack/scripts"; exit 1
fi

echo "== installing flintlockd binary =="
if [ ! -x /usr/local/bin/flintlockd ]; then
  # provision.sh 'all' usually installs it; fall back to building from source.
  if [ -f "$FLINTLOCK_DIR/bin/flintlockd" ]; then
    install -m0755 "$FLINTLOCK_DIR/bin/flintlockd" /usr/local/bin/flintlockd
  else
    (cd "$FLINTLOCK_DIR" && make build 2>/dev/null || true)
    [ -f "$FLINTLOCK_DIR/bin/flintlockd" ] && install -m0755 "$FLINTLOCK_DIR/bin/flintlockd" /usr/local/bin/flintlockd
  fi
fi
command -v flintlockd >/dev/null || { echo "FATAL: flintlockd not installed"; exit 1; }

echo "== detecting containerd socket =="
CONTAINERD_SOCK=/run/containerd-dev/containerd.sock
[ -S "$CONTAINERD_SOCK" ] || CONTAINERD_SOCK=/run/containerd/containerd.sock

echo "== writing flintlockd systemd unit =="
cat >/etc/systemd/system/flintlockd.service <<EOF
[Unit]
Description=flintlockd (acceptance)
After=network-online.target containerd.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/flintlockd run \\
  --grpc-endpoint=0.0.0.0:${GRPC_PORT} \\
  --containerd-socket=${CONTAINERD_SOCK} \\
  --parent-iface=${PARENT_IFACE} \\
  --insecure --verbosity 1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now flintlockd.service

echo "== waiting for flintlockd :${GRPC_PORT} =="
for i in $(seq 1 60); do
  if timeout 2 bash -c "</dev/tcp/127.0.0.1/${GRPC_PORT}" 2>/dev/null; then
    echo "flintlockd is listening"; exit 0
  fi
  sleep 2
done
echo "FATAL: flintlockd not listening on ${GRPC_PORT}"; journalctl -u flintlockd --no-pager | tail -50; exit 1
