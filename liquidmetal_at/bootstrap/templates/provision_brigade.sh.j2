#!/usr/bin/env bash
# Build brigade from source and run it as a named Erlang node under systemd.
# config/config.exs is rendered separately (peer-aware) and copied in before compile.
set -euo pipefail

BRIGADE_DIR=/opt/brigade
MISE=/usr/local/bin/mise
NODE_NAME="brigade@{{ private_ip }}"
COOKIE={{ cookie }}
GRPC_PORT={{ grpc_port }}
STATUS_PORT={{ status_port }}

cd "$BRIGADE_DIR"
$MISE trust || true
$MISE install

echo "== fetching + compiling brigade deps =="
$MISE exec -- mix local.hex --force
$MISE exec -- mix local.rebar --force
$MISE exec -- mix deps.get
$MISE exec -- mix compile

echo "== writing brigade systemd unit (node ${NODE_NAME}) =="
cat >/etc/systemd/system/brigade.service <<EOF
[Unit]
Description=brigade orchestrator (acceptance)
After=network-online.target flintlockd.service
Wants=network-online.target
Requires=flintlockd.service

[Service]
WorkingDirectory=${BRIGADE_DIR}
Environment=HOME=/root
Environment=RELEASE_COOKIE=${COOKIE}
# Bind EPMD + Erlang distribution to the private IP (loopback added implicitly) so peers
# can query this node's EPMD. The default socket-activated epmd binds loopback only.
Environment=ERL_EPMD_ADDRESS={{ private_ip }}
ExecStart=${MISE} exec -- elixir --name ${NODE_NAME} --cookie ${COOKIE} --erl "-kernel inet_dist_listen_min {{ dist_min }} inet_dist_listen_max {{ dist_max }}" -S mix run --no-halt
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
# Drop the loopback-only socket-activated epmd so beam starts its own bound to the private
# IP (via ERL_EPMD_ADDRESS above). If a loopback epmd is already bound on 4369, beam reuses
# it instead of rebinding, so stop + mask before starting brigade.
systemctl stop epmd.socket epmd.service 2>/dev/null || true
systemctl mask epmd.socket epmd.service 2>/dev/null || true
pkill -x epmd 2>/dev/null || true
systemctl enable --now brigade.service

echo "== waiting for brigade gRPC :${GRPC_PORT} and status :${STATUS_PORT} =="
ok=0
for i in $(seq 1 90); do
  if timeout 2 bash -c "</dev/tcp/127.0.0.1/${GRPC_PORT}" 2>/dev/null \
     && timeout 2 bash -c "</dev/tcp/127.0.0.1/${STATUS_PORT}" 2>/dev/null; then
    ok=1; break
  fi
  sleep 2
done
if [ "$ok" != "1" ]; then
  echo "FATAL: brigade not listening"; journalctl -u brigade --no-pager | tail -80; exit 1
fi
echo "brigade up on ${NODE_NAME}"
